# Server-only secrets. NEVER commit real values. NEVER prefix any of
# these with VITE_ or expose them to the frontend build.

NODE_ENV=development
PORT=4000

# Postgres connection string for Prisma (Supabase project's connection
# pooler URI). Server-only.
DATABASE_URL=postgresql://user:password@localhost:5432/creditchakra

# Supabase project settings (server-side verification of user JWTs).
SUPABASE_URL=https://your-project.supabase.co
# Public anon key — also used client-side, safe to duplicate in
# frontend/.env, but backend needs it to verify JWTs against the
# correct project.
SUPABASE_ANON_KEY=your-anon-key-here
# Bypasses Row Level Security. Server-only. Used ONLY for admin/seed/
# migration operations — never for ordinary per-request user actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend origin(s) allowed to call this API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AES-256-GCM key for encrypting sensitive applicant fields at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-base64-key-here

# Session/cookie signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=your-session-secret-here

# Optional: LLM provider key for CreditChakra AI. The app works fully
# without this (deterministic fallback answers from stored data).
LLM_API_KEY=

# Optional: bot-protection challenge provider secret (e.g. Turnstile).
TURNSTILE_SECRET_KEY=

# TEMPORARY. Set to "true" to bypass Supabase Auth entirely in favor of
# a local email/password shim (src/lib/localAuth.ts), so you can run
# the app end-to-end without a real Supabase project. Off by default.
# Read SECURITY.md's "Temporary local auth mode" before turning this
# on anywhere but a local demo — flip it back to "false" (or unset)
# once you have a real Supabase project wired in.
LOCAL_AUTH_MODE=false
