# Public configuration only. These are safe to expose in the browser
# bundle — their security comes from Supabase RLS + our own backend's
# authorization checks, never from keeping them secret (Section 2).
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY, encryption keys, or LLM API
# keys here or in any VITE_* variable — those are backend/.env only.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:4000/api

# TEMPORARY. Must match backend's LOCAL_AUTH_MODE. When "true", login/
# signup go through the backend's local email/password shim instead of
# Supabase. Off by default — see SECURITY.md's "Temporary local auth
# mode" before enabling this anywhere but a local demo.
VITE_LOCAL_AUTH_MODE=false
